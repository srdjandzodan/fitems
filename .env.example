BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="c0e126001@smtp-brevo.com"
# Unesite vaš Brevo SMTP Master Password / API ključ ovde:
BREVO_SMTP_KEY="YOUR_BREVO_SMTP_PASSWORD_OR_KEY"

